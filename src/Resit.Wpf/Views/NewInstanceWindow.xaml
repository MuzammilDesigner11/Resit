<Window x:Class="Resit.Views.NewInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resit.ico"
        Title="New instance" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBackground}">
    <Window.Resources>
        <!-- A selectable card for the edition choice. -->
        <Style x:Key="EditionCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource Divider}"
                                BorderThickness="2" CornerRadius="10" Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,20,28,24">
        <TextBlock Text="New instance" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />

        <TextBlock Text="Name" Style="{StaticResource SectionHeader}" />
        <TextBox x:Name="NameBox" />

        <TextBlock Text="Edition" Style="{StaticResource SectionHeader}" />
        <UniformGrid Columns="2">
            <RadioButton x:Name="PlayOption" GroupName="Edition" Style="{StaticResource EditionCard}" Margin="0,0,6,0" IsChecked="True" Checked="OnEditionChanged">
                <StackPanel>
                    <TextBlock Text="Google Play" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Full Android with Play Store and Google apps." Style="{StaticResource Hint}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="MinimalOption" GroupName="Edition" Style="{StaticResource EditionCard}" Margin="6,0,0,0" Checked="OnEditionChanged">
                <StackPanel>
                    <TextBlock Text="Minimal" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Firefox and a file manager only. No Google services, least RAM and CPU." Style="{StaticResource Hint}" />
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <TextBlock Text="Android version" Style="{StaticResource SectionHeader}" />
        <ComboBox x:Name="ImageBox" SelectionChanged="OnImageChanged" />
        <TextBlock x:Name="ImageHint" Style="{StaticResource Hint}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Performance" Style="{StaticResource SectionHeader}" />
                <ComboBox x:Name="PerfBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Display" Style="{StaticResource SectionHeader}" />
                <ComboBox x:Name="DisplayBox" />
            </StackPanel>
        </Grid>

        <!-- Download progress -->
        <Border x:Name="ProgressPanel" Visibility="Collapsed" Background="{StaticResource CardBackground}" CornerRadius="10" Padding="14,12" Margin="0,18,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                    <TextBlock x:Name="ProgressTitle" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                </DockPanel>
                <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,10,0,8" Maximum="100" />
                <TextBlock x:Name="ProgressDetail" Foreground="{StaticResource TextSecondary}" FontSize="12" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Style="{StaticResource SubtleButton}" Margin="0,0,10,0" Click="OnCancel" />
            <Button x:Name="CreateButton" Content="Create" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnCreate" />
        </StackPanel>
    </StackPanel>
</Window>
