<Window x:Class="Resit.Views.KeymapOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Title="Resit controls">
    <Grid>
        <!-- Darkens the screen while editing and catches clicks on empty space. -->
        <Border x:Name="EditTint" Background="#80000000" Visibility="Collapsed" MouseLeftButtonDown="OnTintClick" />

        <Canvas x:Name="ControlsCanvas" ClipToBounds="True" />

        <!-- Editor toolbar -->
        <Border x:Name="EditBar" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                Background="#F01B1D25" CornerRadius="10" Padding="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SubtleButton}" Padding="12,7" Margin="2" Click="OnAddTap" ToolTip="A key that taps one spot">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,1,6,0" />
                            <TextBlock Text="Tap" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleButton}" Padding="12,7" Margin="2" Click="OnAddJoystick" ToolTip="WASD movement joystick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7FC;" Margin="0,1,6,0" />
                            <TextBlock Text="Joystick" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleButton}" Padding="12,7" Margin="2" Click="OnClear" Content="Clear all" />
                    <Rectangle Width="1" Fill="{StaticResource Divider}" Margin="6,4" />
                    <Button Style="{StaticResource SubtleButton}" Padding="12,7" Margin="2" Click="OnCancel" Content="Cancel" />
                    <Button Style="{StaticResource AccentButton}" Padding="14,7" Margin="2" Click="OnSave" Content="Save" />
                </StackPanel>
                <TextBlock x:Name="EditHint" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="6,6,6,2" TextWrapping="Wrap" MaxWidth="460" />
            </StackPanel>
        </Border>

        <!-- Short notices: screenshot saved, app installed, ... -->
        <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                Background="#E61B1D25" CornerRadius="16" Padding="16,8" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" MaxWidth="420" />
        </Border>
    </Grid>
</Window>
