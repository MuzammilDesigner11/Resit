<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Margin" Value="0,18,0,8" />
    </Style>

    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style Selector="Button PathIcon, ToggleButton PathIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>

    <Style Selector="MenuItem PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <!-- Instance cards light up under the mouse. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
    </Style>
    <Style Selector="Border.card:pointerover">
        <Setter Property="Background" Value="{StaticResource CardHover}" />
    </Style>

    <Style Selector="Rectangle.divider">
        <Setter Property="Fill" Value="{StaticResource Divider}" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
</Styles>
