<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand colours: cream, warm near-black "ink", and deep lake teal. -->
    <Color x:Key="CreamColor">#FFF4EFE6</Color>
    <Color x:Key="InkColor">#FF1E1C19</Color>
    <Color x:Key="LakeColor">#FF1F6F78</Color>

    <!-- Warm charcoal UI, lake-teal accent, cream text. -->
    <SolidColorBrush x:Key="AppBackground" Color="#FF161513" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FF1D1B19" />
    <SolidColorBrush x:Key="CardBackground" Color="#FF262421" />
    <SolidColorBrush x:Key="CardHover" Color="#FF2E2B28" />
    <SolidColorBrush x:Key="Divider" Color="#FF36322E" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource LakeColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF26828C" />
    <SolidColorBrush x:Key="AccentPressed" Color="#FF195C64" />
    <SolidColorBrush x:Key="AccentSoft" Color="#331F6F78" />
    <!-- Lake teal brightened enough to read as text or an icon on the dark background. -->
    <SolidColorBrush x:Key="AccentText" Color="#FF6CC0C7" />
    <!-- Selection outlines in the game-controls editor, over any game picture. -->
    <SolidColorBrush x:Key="Highlight" Color="#FF5DB8C0" />
    <!-- Text and icons drawn on top of the accent. -->
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource CreamColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF4EFE6" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFA39C90" />
    <SolidColorBrush x:Key="Success" Color="#FF3DD68C" />
    <SolidColorBrush x:Key="Warning" Color="#FFFFB547" />
    <SolidColorBrush x:Key="Danger" Color="#FFFF5C6C" />
    <SolidColorBrush x:Key="OverlayPanel" Color="#F01B1D25" />

    <!-- Filled lake-teal button for the main action. -->
    <ControlTheme x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentHover}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{StaticResource AccentPressed}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </ControlTheme>

    <!-- Quiet button for secondary actions (Cancel, Clear all). -->
    <ControlTheme x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="16,9" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="#2AFFFFFF" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="#38FFFFFF" />
        </Style>
    </ControlTheme>

    <!-- Square icon button used in the player toolbar and on instance cards. -->
    <ControlTheme x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="IconToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Content="{TemplateBinding Content}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        </Style>
    </ControlTheme>

    <!-- A selectable card, used for the edition choice. -->
    <ControlTheme x:Key="EditionCard" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Divider}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="2" CornerRadius="10" Padding="14,12">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource CardHover}" />
        </Style>
        <Style Selector="^:checked">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
