<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Resit.Views"
        x:Class="Resit.Views.PlayerWindow"
        Icon="/Resit.ico"
        Title="Resit" Width="560" Height="1000" MinWidth="320" MinHeight="320"
        Background="#FF000000">
    <Grid ColumnDefinitions="*,Auto">

        <!-- Screen -->
        <Grid x:Name="DisplayArea" Background="#FF000000" SizeChanged="OnDisplayAreaSizeChanged">
            <!-- Hidden until Android has booted; the progress panel shows meanwhile. -->
            <views:EmulatorHost x:Name="Host" HorizontalAlignment="Center" VerticalAlignment="Center" Width="1" Height="1" IsVisible="False" />

            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                <Image Source="/Assets/logo-256.png" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,20" />
                <TextBlock x:Name="LoadingText" Text="Starting…" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                <ProgressBar x:Name="LoadingBar" Height="6" Margin="0,14,0,8" Maximum="100" Value="2" />
                <DockPanel>
                    <TextBlock x:Name="LoadingPercent" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                    <TextBlock x:Name="LoadingDetail" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>

            <!-- Popups are separate native windows, so they show above the embedded emulator. -->
            <Popup x:Name="ToastPopup" PlacementTarget="{Binding #DisplayArea}" Placement="AnchorAndGravity"
                   PlacementAnchor="Bottom" PlacementGravity="Top" VerticalOffset="-24" IsLightDismissEnabled="False">
                <Border Background="{StaticResource OverlayPanel}" CornerRadius="16" Padding="16,8" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" MaxWidth="420" />
                </Border>
            </Popup>

            <!-- Drops down from the top edge in fullscreen, like other emulators. -->
            <Popup x:Name="FullscreenBar" PlacementTarget="{Binding #DisplayArea}" Placement="AnchorAndGravity"
                   PlacementAnchor="Top" PlacementGravity="Bottom" IsLightDismissEnabled="False">
                <Border Background="{StaticResource OverlayPanel}" CornerRadius="0,0,14,14" Padding="10,6" BorderBrush="{StaticResource Divider}" BorderThickness="1,0,1,1">
                    <StackPanel Orientation="Horizontal">
                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Back" AutomationProperties.Name="Back" Click="OnBack"><PathIcon Data="{StaticResource IconBack}" /></Button>
                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Home" AutomationProperties.Name="Home" Click="OnHome"><PathIcon Data="{StaticResource IconHome}" /></Button>
                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Recent apps" AutomationProperties.Name="Recent apps" Click="OnRecents"><PathIcon Data="{StaticResource IconRecents}" /></Button>
                        <Rectangle Width="1" Classes="divider" Margin="6,8" />
                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Volume up" AutomationProperties.Name="Volume up" Click="OnVolumeUp"><PathIcon Data="{StaticResource IconVolumeUp}" /></Button>
                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Volume down" AutomationProperties.Name="Volume down" Click="OnVolumeDown"><PathIcon Data="{StaticResource IconVolumeDown}" /></Button>
                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Screenshot" AutomationProperties.Name="Screenshot" Click="OnScreenshot"><PathIcon Data="{StaticResource IconCamera}" /></Button>
                        <Rectangle Width="1" Classes="divider" Margin="6,8" />
                        <Button Theme="{StaticResource SubtleButton}" Padding="12,6" Margin="4,0,0,0" Click="OnFullscreen">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconExitFullscreen}" Width="14" Height="14" />
                                <TextBlock Text="Exit fullscreen (F11)" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Side toolbar -->
        <Border x:Name="Toolbar" Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource Divider}" BorderThickness="1,0,0,0">
            <DockPanel Margin="6,8">
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Settings" AutomationProperties.Name="Settings" Click="OnSettings"><PathIcon Data="{StaticResource IconSettings}" /></Button>
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Shut down" AutomationProperties.Name="Shut down" Click="OnPower" Foreground="{StaticResource Danger}"><PathIcon Data="{StaticResource IconPower}" /></Button>
                </StackPanel>
                <StackPanel>
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Back" AutomationProperties.Name="Back" Click="OnBack"><PathIcon Data="{StaticResource IconBack}" /></Button>
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Home" AutomationProperties.Name="Home" Click="OnHome"><PathIcon Data="{StaticResource IconHome}" /></Button>
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Recent apps" AutomationProperties.Name="Recent apps" Click="OnRecents"><PathIcon Data="{StaticResource IconRecents}" /></Button>
                    <Rectangle Height="1" Classes="divider" Margin="6,8" />
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Volume up" AutomationProperties.Name="Volume up" Click="OnVolumeUp"><PathIcon Data="{StaticResource IconVolumeUp}" /></Button>
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Volume down" AutomationProperties.Name="Volume down" Click="OnVolumeDown"><PathIcon Data="{StaticResource IconVolumeDown}" /></Button>
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Sound output device" AutomationProperties.Name="Sound output device" Click="OnSoundOutput"><PathIcon Data="{StaticResource IconSound}" /></Button>
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Rotate" AutomationProperties.Name="Rotate" Click="OnRotate"><PathIcon Data="{StaticResource IconRotate}" /></Button>
                    <Rectangle Height="1" Classes="divider" Margin="6,8" />
                    <ToggleButton x:Name="ControlsToggle" Theme="{StaticResource IconToggle}" ToolTip.Tip="Edit game controls" AutomationProperties.Name="Edit game controls" Click="OnEditControls"><PathIcon Data="{StaticResource IconGamepad}" /></ToggleButton>
                    <ToggleButton x:Name="KeymapToggle" Theme="{StaticResource IconToggle}" ToolTip.Tip="Game controls on/off" AutomationProperties.Name="Game controls on/off" Click="OnKeymapToggle" IsChecked="True"><PathIcon Data="{StaticResource IconKeyboard}" /></ToggleButton>
                    <Button x:Name="ScreenshotButton" Theme="{StaticResource IconButton}" AutomationProperties.Name="Screenshot" Click="OnScreenshot"><PathIcon Data="{StaticResource IconCamera}" /></Button>
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Install APK" AutomationProperties.Name="Install APK" Click="OnInstallApk"><PathIcon Data="{StaticResource IconInstall}" /></Button>
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Fullscreen (F11)" AutomationProperties.Name="Fullscreen (F11)" Click="OnFullscreen"><PathIcon Data="{StaticResource IconFullscreen}" /></Button>
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="More emulator controls (location, battery, camera…)" AutomationProperties.Name="More emulator controls (location, battery, camera…)" Click="OnExtendedControls"><PathIcon Data="{StaticResource IconExtended}" /></Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
