<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Resit.App"
             Name="Resit"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Resit/Views/Theme.axaml" />
                <ResourceInclude Source="avares://Resit/Views/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Fluent controls (checkboxes, sliders, focus rings) follow the brand accent. -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#FF1F6F78" RegionColor="#FF1D1B19" BaseHigh="#FFF4EFE6" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Resit/Views/Styles.axaml" />
    </Application.Styles>
</Application>
